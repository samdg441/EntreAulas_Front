{
  "name": "entre-aulas-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node copy-redirects.js && node scripts/write-version.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node scripts/vitest.mjs run src/test/unit src/test/integration src/test/regression src/test/api src/test/security",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run src/test/unit src/test/integration src/test/regression src/test/api src/test/security --coverage",
    "test:api": "node scripts/vitest.mjs run src/test/api",
    "test:security": "node scripts/vitest.mjs run src/test/security",
    "test:regression": "node scripts/vitest.mjs run src/test/regression",
    "test:performance": "node scripts/vitest.mjs run src/test/performance",
    "test:carga": "node carga/carga-api.mjs",
    "test:e2e": "npm --prefix e2e run test:e2e",
    "sonar": "node scripts/vitest.mjs run src/test/unit src/test/integration src/test/regression src/test/api src/test/security --coverage && node scripts/clean-lcov.cjs && npx @sonar/scan"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "exceljs": "^3.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.544.0",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-is": "^19.1.1",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.2.1",
    "sonner": "^2.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.14.9",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.2"
  }
}
