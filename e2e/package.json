{
  "name": "entre-aulas-front-e2e",
  "private": true,
  "description": "Cypress E2E para RQ1–RQ5, RQ18, RQ19 y RQ22–RQ25. Proyecto aparte (como CYPRESS-ENTERPRISE): npm ci del front no descarga Cypress.",
  "scripts": {
    "front": "npm --prefix .. run dev -- --port 3001 --strictPort",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e",
    "cy:api": "cypress run --e2e --config-file cypress.api.config.ts",
    "cy:security": "cypress run --e2e --config-file cypress.api.config.ts --spec 'cypress/e2e/security/**/*.cy.ts'",
    "cy:a11y": "cypress run --e2e --browser ${CY_BROWSER:-chromium} --spec 'cypress/e2e/accessibility/**/*.cy.ts'",
    "cy:rq1-rq5": "cypress run --e2e --browser ${CY_BROWSER:-chromium} --spec 'cypress/e2e/ui/rq[1-5]-*.cy.ts,cypress/e2e/regression/rq1-rq5-*.cy.ts,cypress/e2e/accessibility/rq1-rq5-*.cy.ts,cypress/e2e/api/rq1-rq5-*.cy.ts,cypress/e2e/security/rq1-rq5-*.cy.ts'",
    "cy:ci": "cypress run --e2e --reporter junit --reporter-options mochaFile=../reports/cypress/junit-[hash].xml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "start-server-and-test front http://localhost:3001 cy:run"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "cypress": "16.1.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "^7.0.2"
  }
}
