# Proveedor para test:observe: ollama (recomendado en clase), openai o gemini.
AI_PROVIDER=ollama

# Navegador local. En Windows con Edge (Chromium):
HEADLESS=false
CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
STAGEHAND_LOG_LEVEL=info

# Front de EntreAulas (local o Vercel).
FRONT_URL=http://localhost:3001

# Credenciales de coordinador (RQ19, RQ22–RQ25). NO subir .env al repo.
LOGIN_TIPO=Coordinador
LOGIN_EMAIL=tu.correo@udemedellin.edu.co
LOGIN_PASSWORD=tu_clave
LOGIN_DASHBOARD=/dashboard-coordinador

# Credenciales de administrador (RQ18 QR). Si faltan, se usan LOGIN_*.
ADMIN_TIPO=Administrador
ADMIN_EMAIL=tu.admin@udemedellin.edu.co
ADMIN_PASSWORD=tu_clave_admin

# Ollama local (ya instalado en tu PC).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# Opcionales (solo si usas nube):
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-4.1-mini
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=google/gemini-2.5-flash
