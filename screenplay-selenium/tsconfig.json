{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "@wdio/globals/types"]
  },
  "include": ["features/**/*.ts", "test/**/*.ts", "wdio.conf.ts"]
}
